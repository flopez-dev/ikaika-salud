---
/** «Encuéntranos» y «Aparcamientos», como en ikaikasalud.es (es el destino de «Cómo llegar»). */
import Icono from './Icono.astro';
import { contacto, horario } from '../lib/contacto';
import { aparcamientos, encuentranos } from '../lib/recorrido';
import { withBase } from '../lib/withBase';
---

<section id="contacto" class="px-4 py-20" aria-labelledby="contacto-titulo">
  <div class="mx-auto max-w-6xl">
    <h2 id="contacto-titulo" class="heading-3 text-center sm:text-4xl">
      Encuéntranos
    </h2>
    <p class="body-big text-secondary mt-3 text-center">
      {`${contacto.calle}, ${contacto.codigoPostal}, ${contacto.ciudad}.`}
    </p>
    <div class="mx-auto mt-8 grid max-w-3xl gap-6 sm:grid-cols-2">
      {encuentranos.map((t) => (
        <p class="body-6 text-secondary text-justify">{t}</p>
      ))}
    </div>
    <div class="mx-auto mt-8 flex max-w-3xl flex-wrap items-start justify-center gap-x-12 gap-y-6">
      <div class="flex gap-3">
        <Icono nombre="clock" class="size-6 shrink-0" />
        <dl class="body-6 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
          {horario.map((h) => (
            <>
              <dt class="font-bold">{h.dias}</dt>
              <dd class="text-secondary">{h.horas}</dd>
            </>
          ))}
        </dl>
      </div>
      <a
        href={contacto.mapaHref}
        class="btn btn-primary px-8 font-normal"
        target="_blank"
        rel="noopener"
      >
        <Icono nombre="map-pin" />
        Abrir en Google Maps
      </a>
    </div>

    <h3 class="heading-2 mt-20 text-center text-3xl sm:text-4xl">Aparcamientos</h3>
    <p class="body-6 mt-2 text-center">Aparcamientos cercanos a nuestra clínica Ikaika Salud</p>
    <ul class="mt-8 grid gap-6 sm:grid-cols-3">
      {aparcamientos.map((a) => (
        <li>
          <img
            src={withBase(a.imagen)}
            alt={a.alt}
            width="768"
            height="480"
            loading="lazy"
            decoding="async"
            class="rounded-box aspect-16/10 w-full object-cover"
          />
          <p class="body-6 mt-3">{a.nombre}</p>
          <p class="body-6 text-secondary">{a.detalle}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
