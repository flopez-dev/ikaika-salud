---
import '../styles/global.css';
import { withBase } from '../lib/withBase';
import { nombreSitio } from '../lib/sitio';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Cierra la indexación de todo el sitio en una copia que no es el dominio real, para que no
// compita como contenido duplicado. Lo pone deploy-pages.yml (la copia de develop en GitHub
// Pages). En CI y en local queda sin definir. Se combina con el `noindex` de la propia
// página (la 404 ya lo lleva).
const sitioNoIndexado = process.env.NOINDEX_SITE === 'true';
---

<html lang="es" data-theme="ikaika">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Una página noindex no declara canonical: el de la 404 sería una URL que no existe. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {(noindex || sitioNoIndexado) && (
      <meta name="robots" content={sitioNoIndexado ? 'noindex, nofollow' : 'noindex, follow'} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={nombreSitio} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonical} />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

    <slot name="head" />
  </head>
  <body class="bg-base-100 text-base-content min-h-dvh antialiased">
    <a class="btn btn-primary btn-sm absolute -top-full left-4 z-50 focus:top-4" href="#main">
      Ir al contenido
    </a>
    <slot />
  </body>
</html>
