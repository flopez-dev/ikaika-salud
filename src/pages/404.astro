---
import Base from '../layouts/Base.astro';
import { nombreSitio } from '../lib/sitio';
import { withBase } from '../lib/withBase';
---

<Base title={`Página no encontrada · ${nombreSitio}`} description="Esta página no existe." noindex>
  <main id="main" class="hero min-h-dvh">
    <div class="hero-content text-center">
      <div>
        <h1 class="text-4xl font-bold">Página no encontrada</h1>
        <p class="text-base-content/80 mt-4">La página que buscas no existe o se ha movido.</p>
        <a class="btn btn-primary mt-8" href={withBase('/')}>
          Volver al inicio
        </a>
      </div>
    </div>
  </main>
</Base>
